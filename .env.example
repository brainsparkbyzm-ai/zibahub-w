# Required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zibahub?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Email. Leave unset to show a configuration state instead of pretending mail was sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ZibaHub <notifications@example.com>"

# Stripe. Leave unset until you are ready to take payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Protects POST /api/cron/alerts
CRON_SECRET=""

# Development seed only. Never use the default in production.
SEED_ADMIN_EMAIL="admin@zibahub.example"
SEED_ADMIN_PASSWORD="ZibaHub-Dev-Admin-2026!"
ALLOW_SEED="false"
